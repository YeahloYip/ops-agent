# ============================================================
# ops-agent 配置示例
# 复制为 config.env 后按实际环境修改（config.env 已被 .gitignore 忽略，切勿提交）
#   cp config.env.example config.env && chmod 600 config.env
# ============================================================

# ===== 邮件配置（msmtp）=====
# 依赖 /etc/msmtprc 中的账户配置；MSMTP_ACCOUNT 对应 /etc/msmtprc 里的 account 名
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="ops@example.com"
SMTP_PASS="CHANGE_ME"
MAIL_FROM="ops@example.com"
MAIL_TO="ops@example.com"
MSMTP_ACCOUNT="default"

# ===== 告警策略（只发需要处理的事项）=====
ALERT_ENABLED=true
# CRIT 项重复提醒间隔（小时）
ALERT_CRIT_DEDUPE_HOURS=24
# WARN 项重复提醒间隔（天）
ALERT_WARN_DEDUPE_DAYS=3
# 长期静态类问题（sshd 配置 / EOL / 端口暴露）间隔（天）
ALERT_STATIC_DEDUPE_DAYS=7

# ===== AI 判定闸门（opencode zen 免费模型）=====
# 需要本机安装 opencode（https://opencode.ai），未安装则自动按规则回退
JUDGE_ENABLED=true
# 只用名字带 free 的模型：免费额度可能随时变动，按 free 关键字动态发现 + 失败自动切换
JUDGE_FREE_ONLY=true
# 显式候选（兜底；实际会与 `opencode models` 中的 free 模型合并，上次成功的模型优先）
JUDGE_MODELS="opencode/deepseek-v4.1-flash-free opencode/glm-5.3-flash-free"
JUDGE_TIMEOUT=120
# 单次最多尝试几个候选模型
JUDGE_MAX_ATTEMPTS=6
# LLM 不可用时：false = 仅按规则（CRIT 仍发信）；true = 有 WARN 也发信
JUDGE_FALLBACK_NOTIFY=false
# LLM 不可用且 WARN 数量达到该值时仍发信（0=关闭）
JUDGE_FALLBACK_WARN_MIN=5

# ===== 阈值 =====
DISK_WARN_PERCENT=85
DISK_CRIT_PERCENT=90
DISK_GROWTH_PERCENT=5
INODE_WARN_PERCENT=85
CERT_WARN_DAYS=14
CERT_CRIT_DAYS=7
LOAD_WARN_FACTOR=1.5
LOAD_CRIT_FACTOR=3
MEM_AVAIL_CRIT_MB=150
SWAP_WARN_PERCENT=80
BRUTE_FORCE_WARN=200
FAIL2BAN_BAN_WARN=50
ERROR_5XX_WARN=10
BACKUP_SQL_MAX_AGE_HOURS=26
# 周/月备份库的新鲜度上限（小时）：周备份 8 天、月备份 35 天
BACKUP_WEEKLY_MAX_AGE_HOURS=192
BACKUP_MONTHLY_MAX_AGE_HOURS=840
BACKUP_SIZE_DROP_PERCENT=50
# 体积阈值自适应：allowed = max(DROP_PERCENT, CV_FACTOR × 历史变异系数%)，上限 90
BACKUP_SIZE_CV_FACTOR=3
# 体积判断所需的最少历史样本数（不足则不做体积判断）
BACKUP_SIZE_MIN_SAMPLES=5
# 检查"库/站点是否根本没纳入备份清单"
BACKUP_COVERAGE_CHECK=true
# 已确认"不需要备份"的库/站点目录（列在这里的会降级为 INFO，不再告警）
BACKUP_IGNORED_DBS=""
BACKUP_IGNORED_DIRS=""
# 对象存储云端回读校验（需在 config/backup.conf 启用 QINIU_ENABLED=true；
# qshell 安装/授权见 https://developer.qiniu.com/kodo/1302/qshell ）
QINIU_VERIFY=false
LOG_RETAIN_MONTHS=12
# rkhunter 属性基线刷新间隔（天）
PROPUPDATE_INTERVAL_DAYS=7

# ===== 外部心跳（cron 掉线检测，可选）=====
# 作用：agent 每次巡检结束向 healthchecks.io 报活；超过 Period+Grace 没报，
#       对方会反向告警（cron 挂了 / 机器挂了 / 脚本崩溃）。
# 启用步骤（完整说明见 docs/heartbeat.md）：
#   1) 注册 https://healthchecks.io/ ，Create Check：
#        Period = 12 hours（对应 09:00/21:00 两次巡检）、Grace Time = 2 hours
#        Channels 勾选 Email（否则掉线不会通知你）
#   2) 复制 Check 页面的 Ping URL（形如 https://hc-ping.com/<uuid>）
#   3) 填到下面 HEARTBEAT_URL，并保持 HEARTBEAT_ENABLED=true
#   4) 手动验证：bash scripts/heartbeat-test.sh
#        然后在面板确认 Last Ping / 状态为 Up
# 运行规则：正常巡检 GET <url>；当天有 CRIT 时 GET <url>/fail；
#          --dry-run / --report-only 不发心跳；留空则自动跳过。
# 注意：<uuid> 是私有标识，只放在本文件（已 gitignore），不要提交到仓库。
HEARTBEAT_ENABLED=true
HEARTBEAT_URL=""

# ===== 路径 =====
NGINX_VHOST_DIR="/etc/nginx/conf.d"
NGINX_BIN="/usr/sbin/nginx"
WEBROOT="/var/www"
LOGDIR="/var/log/nginx"
BACKUP_DIR="/var/backups/ops-agent"
ACME_LOG="/root/.acme.sh/acme.sh.log"
ACME_HOME="/root/.acme.sh"
MYSQL_CNF="/root/.my.cnf"
SERVER_IP="203.0.113.10"
SERVER_NAME="web-01"

# ===== 检查范围 =====
SITES="example.com www.example.com example.org"
REQUIRED_SERVICES="nginx mysql php8.2-fpm fail2ban sshd"
OS_NAME="Debian 12 bookworm"
OS_EOL_DATE="2028-06-30"
