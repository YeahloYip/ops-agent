# ops-agent 定时任务示例
# 用法：按实际路径替换 /opt/ops-agent，然后 crontab -e 粘贴
# 注意：各任务已错峰，避免数据库备份/文件备份同时抢占 IO

# ===== 巡检 =====
# 09:00 完整巡检（CRIT 立即发；WARN 经 AI 判定后才发）
0 9 * * * /opt/ops-agent/agent.sh >> /opt/ops-agent/logs/cron.log 2>&1
# 21:00 仅 CRIT 巡检（不调 AI、不发 WARN，缩短关键问题发现延迟）
0 21 * * * /opt/ops-agent/agent.sh --crit-only >> /opt/ops-agent/logs/cron.log 2>&1

# ===== 安全扫描 =====
# 每月 1 日 00:00 日志轮转
0 0 1 * * /opt/ops-agent/scripts/log-rotate.sh >> /opt/ops-agent/logs/cron.log 2>&1
# 每日 00:30 更新病毒库/特征库（rkhunter 属性基线默认每 7 天刷新一次）
30 0 * * * /opt/ops-agent/scripts/update-databases.sh >> /opt/ops-agent/logs/cron.log 2>&1
# 每日 00:45 rkhunter 扫描
45 0 * * * /opt/ops-agent/scripts/rkhunter-scan.sh >> /opt/ops-agent/logs/cron.log 2>&1
# 每日 01:02 ClamAV 扫描
2 1 * * * /opt/ops-agent/scripts/clamav-scan.sh >> /opt/ops-agent/logs/cron.log 2>&1

# ===== 备份（错峰）=====
5 0 * * *   /opt/ops-agent/scripts/backup.sh daily   >> /opt/ops-agent/logs/cron.log 2>&1
15 0 * * 1  /opt/ops-agent/scripts/backup.sh weekly  >> /opt/ops-agent/logs/cron.log 2>&1
25 0 1 * *  /opt/ops-agent/scripts/backup.sh monthly >> /opt/ops-agent/logs/cron.log 2>&1
35 0 1 * *  /opt/ops-agent/scripts/backup.sh file    >> /opt/ops-agent/logs/cron.log 2>&1
