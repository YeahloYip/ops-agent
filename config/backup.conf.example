# 数据库/文件备份清单示例
# 复制为 config/backup.conf 后按实际环境修改（已在 .gitignore 中忽略）
#   cp config/backup.conf.example config/backup.conf && chmod 600 config/backup.conf

# 每日备份的数据库
DAILY_DBS="app_db"

# 每周备份（周一）
WEEKLY_DBS="shop_db"

# 每月备份（1 日）
MONTHLY_DBS=""

# 文件备份（每月 1 日），取 ${WEBROOT}/<name>
FILE_BACKUP_DIRS="example.com example.org"

# 本地保留天数
LOCAL_RETAIN_DAYS=30

# 对象存储（七牛 Kodo）备份，不需要可设 QINIU_ENABLED=false
QINIU_ENABLED=false
QINIU_QSHELL="/usr/local/bin/qshell"
QINIU_BUCKET="my-backup"
